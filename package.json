{
  "name": "qwis-app",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "npm run drizzle:generate --workspace=api",
    "db:migrate": "npm run drizzle:migrate --workspace=api",
    "db:seed": "npm run drizzle:seed --workspace=api"
  },
  "devDependencies": {
    "drizzle-kit": "^0.24.0",
    "drizzle-orm": "^0.33.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.12",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.7.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
